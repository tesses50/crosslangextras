func main(args)
{
    var dd = Tesses.CrossLang.Args(args);
    if(dd.Arguments.Count > 0)
    {

        switch(dd.Arguments[0])
        {
            case "args":
                each(var arg : dd.Arguments)
                {
                    Console.WriteLine(arg);
                }
                break;
            case "build":
                return Tesses.CrossLang.Shell.Build(dd);
                break;
            case "run":
                return Tesses.CrossLang.Shell.Run(dd);
                break;
            case "debug":
                 return Tesses.CrossLang.Shell.Debug(dd);
                 break;
            case "new":
                return Tesses.CrossLang.Shell.New(dd);
                break;
            case "install-console":
                return Tesses.CrossLang.Shell.InstallConsole(dd);
                break;
            case "install-app":
                return Tesses.CrossLang.Shell.InstallApp(dd);
                break;
            case "install-template":
                return Tesses.CrossLang.Shell.InstallTemplate(dd);
                break;
            case "install-tool":
                return Tesses.CrossLang.Shell.InstallTool(dd);
                break;
            case "console":
                return Tesses.CrossLang.Shell.Console(dd);
                break;
            case "tool":
                return Tesses.CrossLang.Shell.Tool(dd);
                break;
            case "tool-test":
                return Tesses.CrossLang.Shell.ToolTest(dd);
                break;
            case "add-project":
                return Tesses.CrossLang.Shell.AddProject(dd);
                break;
            case "add-dependency":
                return Tesses.CrossLang.Shell.AddDependency(dd);
                break;
            case "upload-package":
                return Tesses.CrossLang.Shell.UploadPackage(dd);
                break;
            case "login":
                return Tesses.CrossLang.Shell.Login(dd);
                break;
            case "logout":
                return Tesses.CrossLang.Shell.Logout(dd);
                break;
            case "configdir":
                return Tesses.CrossLang.Shell.ConfigDir(dd);
                break;
            default:
                return Tesses.CrossLang.Shell.Default(dd);
        }
        
    
    } else return Tesses.CrossLang.Shell.Default(dd);
    return 0;
}
