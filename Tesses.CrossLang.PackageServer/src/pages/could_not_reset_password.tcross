func Pages.ResetPasswordFailed(reason)
{
    var active = DB.LoginButton(ctx,false,"");
  
    
    var pages = [
            {
                active = false,
                route = "/packages",
                text = "Packages"
            },
            {
                active =  false,
                route = "/upload",
                text = "Upload"
            },
            active
        ];
    return Shell($"Reset Password Failed {reason}", pages,<h1>Reset Password Failed {reason}</h1>);
}