func Pages.CheckEmail(ctx)
{
    var pages = [
            {
                active = false,
                route = "/packages",
                text = "Packages"
            },
            {
                active =  false,
                route = "/upload",
                text = "Upload"
            },
            DB.LoginButton(ctx,false)
        ];
    var html = <div class={"container"}>
                <h1>Please check your email.</h1>
                <p>
                    The email may or may not be in your spam.
                </p>
            </div>;
    return Shell("Check your email",pages,html);
}