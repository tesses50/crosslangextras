
func WebAppMain(args)
{
    return (ctx)=>{
        if(ctx.Path == "/")
        {
            ctx.WithMimeType("text/html").SendText(<h1>Hello, world</h1>);
            return true;
        }
        return false;
    };
}
func main(args)
{
    Console.WriteLine("use crosslang webapp-test to test");
}